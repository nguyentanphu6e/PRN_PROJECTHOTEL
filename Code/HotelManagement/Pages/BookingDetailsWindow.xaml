<Window x:Class="HotelManagement.Pages.BookingDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết booking"
        Width="560"
        SizeToContent="Height"
        MinHeight="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBackground}">
    <StackPanel Margin="24">
        <TextBlock Text="THÔNG TIN LƯU TRÚ" Foreground="#718292" FontSize="10" FontWeight="Bold"/>
        <TextBlock x:Name="BookingCodeText" Foreground="{StaticResource Navy}" FontSize="23" FontWeight="Bold" Margin="0,5,0,15"/>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,15"><TextBlock Text="Khách hàng" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="GuestNameText" Foreground="#111111" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,15"><TextBlock Text="Số điện thoại" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="GuestPhoneText" Foreground="#111111" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,15"><TextBlock Text="Email" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="EmailText" Foreground="#111111" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,15"><TextBlock Text="Phòng" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="RoomText" Foreground="#111111" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,15"><TextBlock Text="Ngày nhận phòng" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CheckInText" Foreground="#111111" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,15"><TextBlock Text="Ngày trả phòng" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CheckOutText" Foreground="#111111" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,15"><TextBlock Text="Số khách" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="GuestCountText" Foreground="#111111" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,15"><TextBlock Text="Trạng thái" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="StatusText" Foreground="#111111" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,12,15"><TextBlock Text="Giá mỗi đêm tại thời điểm đặt" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="NightlyRateText" Foreground="#111111" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,15"><TextBlock Text="Số đêm" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="NightsText" Foreground="#111111" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <Border Grid.Row="5" Grid.ColumnSpan="2" Background="#F7F9FB" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tổng tiền phòng" Foreground="{StaticResource Navy}" FontWeight="Bold"/><TextBlock x:Name="RoomTotalText" Grid.Column="1" Foreground="{StaticResource Navy}" FontSize="17" FontWeight="Bold"/></Grid></Border>
            </Grid>
        </Border>
        <Button Content="Đóng" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>
