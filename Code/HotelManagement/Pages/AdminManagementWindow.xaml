<Window x:Class="HotelManagement.Pages.AdminManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý khách sạn" Width="1040" Height="700" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBackground}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="WindowSectionTitle" Text="Quản lý" Foreground="{StaticResource Navy}" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="WindowSectionDescription" Text="Chọn một dòng để xem và chỉnh sửa." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <TabControl x:Name="ManagementTabs" Grid.Row="1" SelectionChanged="ManagementTabs_SelectionChanged">
            <TabItem Header="Tài khoản">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="UsersGrid" SelectionChanged="UsersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.3*"/>
                            <DataGridTextColumn Header="Tài khoản" Binding="{Binding RoleLabel}" Width="125"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="ToggleUserButton" Content="Khóa tài khoản" Style="{StaticResource PrimaryButton}" Click="ToggleUser_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Loại phòng">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="18"/><ColumnDefinition Width=".8*"/></Grid.ColumnDefinitions>
                    <DataGrid x:Name="RoomTypesGrid" SelectionChanged="RoomTypesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên loại phòng" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Sức chứa" Binding="{Binding Capacity}" Width="85"/>
                            <DataGridTextColumn Header="Giá/đêm" Binding="{Binding BasePrice, StringFormat={}{0:N0} ₫}" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="Thông tin loại phòng" Foreground="{StaticResource Navy}" FontWeight="Bold" FontSize="15" Margin="0,0,0,15"/>
                        <TextBlock Text="Tên loại phòng" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RoomTypeNameBox" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>
                        <TextBlock Text="Sức chứa (khách)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RoomTypeCapacityBox" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>
                        <TextBlock Text="Giá mỗi đêm (₫)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RoomTypePriceBox" Style="{StaticResource FieldBox}" Margin="0,0,0,16"/>
                        <Button Content="Lưu loại phòng" Style="{StaticResource PrimaryButton}" Click="SaveRoomType_Click"/>
                        <Button Content="Tạo loại phòng mới" Style="{StaticResource OutlineButton}" Margin="0,8,0,0" Click="NewRoomType_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Phòng">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="18"/><ColumnDefinition Width=".8*"/></Grid.ColumnDefinitions>
                    <DataGrid x:Name="RoomsGrid" SelectionChanged="RoomsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số phòng" Binding="{Binding RoomNumber}" Width="85"/>
                            <DataGridTextColumn Header="Loại phòng" Binding="{Binding RoomTypeName}" Width="*"/>
                            <DataGridTextColumn Header="Tầng" Binding="{Binding Floor}" Width="55"/>
                            <DataGridTextColumn Header="Tình trạng" Binding="{Binding StatusLabel}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="Thông tin phòng" Foreground="{StaticResource Navy}" FontWeight="Bold" FontSize="15" Margin="0,0,0,15"/>
                        <TextBlock Text="Số phòng" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RoomNumberBox" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>
                        <TextBlock Text="Loại phòng" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RoomTypeCombo" Style="{StaticResource FieldCombo}" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="RoomTypeId"/>
                        <TextBlock Text="Tầng" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FloorBox" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>
                        <TextBlock Text="Tình trạng" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RoomStatusCombo" Style="{StaticResource FieldCombo}" Margin="0,0,0,16"/>
                        <Button Content="Lưu thông tin phòng" Style="{StaticResource PrimaryButton}" Click="SaveRoom_Click"/>
                        <Button Content="Thêm phòng mới" Style="{StaticResource OutlineButton}" Margin="0,8,0,0" Click="NewRoom_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <Button Grid.Row="2" Content="Đóng" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click"/>
    </Grid>
</Window>
