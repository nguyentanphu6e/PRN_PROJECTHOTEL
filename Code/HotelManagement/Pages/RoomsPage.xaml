<Page x:Class="HotelManagement.Pages.RoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackground}"
      Loaded="RoomsPage_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,34">
            <Grid Margin="0,0,0,21">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ĐẶT PHÒNG TRỰC TUYẾN" Foreground="#718292" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Tìm phòng phù hợp" Foreground="{StaticResource Navy}" FontSize="27" FontWeight="Bold" Margin="0,5,0,5"/>
                    <TextBlock Text="Chọn ngày lưu trú để xem các phòng còn trống tại khách sạn." Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#39845D" Margin="0,0,8,0"/>
                    <TextBlock Text="Tình trạng phòng được cập nhật" Foreground="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
            </Grid>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width=".9*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Nhận phòng" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CheckInBox" Style="{StaticResource FieldBox}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Trả phòng" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CheckOutBox" Style="{StaticResource FieldBox}"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,14,0"><TextBlock Text="Số người lớn" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="GuestsCombo" Style="{StaticResource FieldCombo}" SelectedIndex="0"><ComboBoxItem Content="1 người lớn" Tag="1"/><ComboBoxItem Content="2 người lớn" Tag="2"/><ComboBoxItem Content="3 người lớn" Tag="3"/><ComboBoxItem Content="4 người lớn" Tag="4"/></ComboBox></StackPanel>
                    <Button x:Name="SearchRoomsButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Content="Tìm phòng" Click="SearchRooms_Click"/>
                </Grid>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Loại phòng" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RoomTypeFilter" Style="{StaticResource FieldCombo}" DisplayMemberPath="Name" SelectionChanged="RoomFilter_SelectionChanged"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Khoảng giá / đêm" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PriceFilter" Style="{StaticResource FieldCombo}" SelectedIndex="0" SelectionChanged="RoomFilter_SelectionChanged"><ComboBoxItem Content="Tất cả giá" Tag="All"/><ComboBoxItem Content="Dưới 500.000 đ" Tag="Under500"/><ComboBoxItem Content="500.000–1.000.000 đ" Tag="500To1M"/><ComboBoxItem Content="1.000.000–2.000.000 đ" Tag="1MTo2M"/><ComboBoxItem Content="Trên 2.000.000 đ" Tag="Over2M"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Sắp xếp giá" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SortFilter" Style="{StaticResource FieldCombo}" SelectedIndex="0" SelectionChanged="RoomFilter_SelectionChanged"><ComboBoxItem Content="Mặc định" Tag="Default"/><ComboBoxItem Content="Giá thấp đến cao" Tag="Ascending"/><ComboBoxItem Content="Giá cao đến thấp" Tag="Descending"/></ComboBox></StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource OutlineButton}" VerticalAlignment="Bottom" Content="Xóa bộ lọc" Click="ClearFilters_Click"/>
                </Grid>
            </Border>
            <Grid Margin="0,0,0,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Phòng phù hợp" Foreground="{StaticResource Navy}" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="SearchSummaryText" Text="Nhập ngày lưu trú để tìm phòng" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                <TextBlock x:Name="ResultCountText" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="LoadingText" Text="Đang tải danh sách phòng..." Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,18,0,18" Visibility="Collapsed"/>
            <ItemsControl x:Name="AvailableRoomsItems">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Margin="0,0,14,14">
                            <StackPanel>
                                <Border Height="150" CornerRadius="9,9,0,0" Background="#A7B2AE">
                                    <Grid><Rectangle Fill="#17324D" Opacity=".12"/><StackPanel VerticalAlignment="Bottom" Margin="16,0,0,14"><TextBlock Text="{Binding RoomTypeName}" Foreground="White" FontSize="12" FontWeight="Bold"/><TextBlock Text="{Binding RoomLabel}" Foreground="White" FontSize="10" Margin="0,3,0,0"/></StackPanel></Grid>
                                </Border>
                                <StackPanel Margin="17,14,17,16">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding RoomTypeName}" Foreground="{StaticResource Navy}" FontSize="16" FontWeight="Bold"/><TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"><Run Text="Phòng "/><Run Text="{Binding RoomNumber, Mode=OneWay}"/><Run Text=" · Tầng "/><Run Text="{Binding Floor, Mode=OneWay}"/></TextBlock></StackPanel><Border Grid.Column="1" Background="{StaticResource GreenTint}" CornerRadius="12" Padding="8,5"><TextBlock Text="Có thể đặt" Foreground="{StaticResource Green}" FontSize="10" FontWeight="SemiBold"/></Border></Grid>
                                    <WrapPanel Margin="0,12,0,12"><Border Background="#F0F4F7" CornerRadius="4" Padding="8,5" Margin="0,0,6,0"><TextBlock Text="{Binding CapacityText}" FontSize="11"/></Border><Border Background="#F0F4F7" CornerRadius="4" Padding="8,5"><TextBlock Text="{Binding StayText}" FontSize="11"/></Border></WrapPanel>
                                    <Border Height="1" Background="{StaticResource Line}"/>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding NightlyPriceText}" Foreground="{StaticResource Navy}" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding EstimatedTotalText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource OutlineButton}" Padding="10,8" Margin="0,0,7,0" Content="Chi tiết" Tag="{Binding}" Click="RoomDetails_Click"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="12,8" Content="Chọn phòng" Tag="{Binding}" Click="ChooseRoom_Click"/></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyResultsText" Text="Không tìm thấy phòng phù hợp với tiêu chí của bạn." Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
