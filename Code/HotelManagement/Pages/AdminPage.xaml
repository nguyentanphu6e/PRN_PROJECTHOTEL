<Page x:Class="HotelManagement.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,34">
            <TextBlock Text="QUẢN TRỊ HỆ THỐNG" Foreground="#718292" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Quản lý khách sạn" Foreground="{StaticResource Navy}" FontSize="27" FontWeight="Bold" Margin="0,5,0,4"/>
            <TextBlock Text="Quản lý tài khoản nhân viên, loại phòng và thông tin từng phòng." Foreground="{StaticResource Muted}" Margin="0,0,0,22"/>

            <UniformGrid Columns="2" Margin="0,0,0,18">
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="19" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TÀI KHOẢN NHÂN VIÊN" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="AccountCountText" Text="0" Foreground="{StaticResource Navy}" FontSize="28" FontWeight="Bold" Margin="0,5"/>
                        <TextBlock x:Name="AccountSummaryText" Text="Tài khoản trong hệ thống" Foreground="{StaticResource Green}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="19">
                    <StackPanel>
                        <TextBlock Text="PHÒNG KHÁCH SẠN" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="RoomCountText" Text="0" Foreground="{StaticResource Navy}" FontSize="28" FontWeight="Bold" Margin="0,5"/>
                        <TextBlock x:Name="RoomSummaryText" Text="Phòng thuộc 0 loại phòng" Foreground="{StaticResource Blue}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="20">
                <StackPanel>
                    <TextBlock Text="Chức năng quản trị" Foreground="{StaticResource Navy}" FontSize="17" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Chọn nhóm cần quản lý. Mỗi nhóm có phạm vi dữ liệu riêng." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource OutlineButton}" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,10,10" Padding="14,12" Click="Accounts_Click">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tài khoản nhân viên" Foreground="{StaticResource Navy}" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Xem danh sách, cập nhật thông tin và bật hoặc khóa tài khoản." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,0,10" Padding="14,12" Click="RoomTypes_Click">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Loại phòng và giá" Foreground="{StaticResource Navy}" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Cập nhật tên loại, sức chứa và giá phòng mỗi đêm." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,10,0" Padding="14,12" Click="Rooms_Click">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Danh sách phòng" Foreground="{StaticResource Navy}" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Quản lý số phòng, tầng, loại phòng và tình trạng phòng." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
