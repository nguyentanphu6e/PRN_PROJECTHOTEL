<Page x:Class="HotelManagement.Pages.MyBookingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,34">
            <TextBlock Text="KHU VỰC KHÁCH HÀNG" Foreground="#718292" FontSize="10" FontWeight="Bold"/>
            <Grid Margin="0,7,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Đặt phòng của tôi" Foreground="{StaticResource Navy}" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Theo dõi các đặt phòng đang chờ và lưu trú của bạn." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Tìm phòng" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="SearchRooms_Click"/>
            </Grid>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="BookingCountText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/>
                    <DataGrid x:Name="BookingsGrid" Height="360" IsReadOnly="True" CanUserResizeRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã booking" Binding="{Binding Code}" Width="150"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding Room}" Width="145"/>
                            <DataGridTextColumn Header="Nhận phòng" Binding="{Binding CheckIn}" Width="110"/>
                            <DataGridTextColumn Header="Trả phòng" Binding="{Binding CheckOut}" Width="110"/>
                            <DataGridTextColumn Header="Số khách" Binding="{Binding GuestCount}" Width="75"/>
                            <DataGridTextColumn Header="Tiền phòng" Binding="{Binding TotalLabel}" Width="120"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="120"/>
                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Hủy" Tag="{Binding BookingId}" IsEnabled="{Binding CanCancel}" Style="{StaticResource OutlineButton}" Padding="8,4" Click="CancelBooking_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,35,0,28">
                        <TextBlock Text="Bạn chưa có đặt phòng nào đang hoạt động." Foreground="{StaticResource Navy}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Các đặt phòng đã hủy hoặc đã trả phòng không hiển thị trong danh sách này." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,14" HorizontalAlignment="Center"/>
                        <Button Content="Tìm phòng" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="SearchRooms_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
