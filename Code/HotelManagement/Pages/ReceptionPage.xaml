<Page x:Class="HotelManagement.Pages.ReceptionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="27,24,27,30">
            <Grid Margin="0,0,0,17">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="TodayText" Text="" Foreground="#718292" FontSize="10" FontWeight="Bold"/><TextBlock Text="Quản lý đặt phòng" Foreground="{StaticResource Navy}" FontSize="25" FontWeight="Bold" Margin="0,4,0,3"/><TextBlock Text="Tìm kiếm, xác nhận và theo dõi các lượt lưu trú." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="＋  Tạo đặt phòng" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CreateBooking_Click"/>
            </Grid>
            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="31" Height="31" CornerRadius="7" Background="{StaticResource BlueTint}"><TextBlock Text="↓" Foreground="{StaticResource Blue}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Nhận phòng hôm nay" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="ArrivalsTodayText" Text="0" Foreground="{StaticResource Navy}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Booking dự kiến đến" Foreground="{StaticResource Green}" FontSize="10"/></StackPanel></Grid></Border>
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="31" Height="31" CornerRadius="7" Background="#F0EDF7"><TextBlock Text="↑" Foreground="#706194" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Trả phòng hôm nay" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="DeparturesTodayText" Text="0" Foreground="{StaticResource Navy}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Booking đang lưu trú" Foreground="{StaticResource Amber}" FontSize="10"/></StackPanel></Grid></Border>
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="31" Height="31" CornerRadius="7" Background="{StaticResource GreenTint}"><TextBlock Text="▦" Foreground="{StaticResource Green}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Đang lưu trú" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="CheckedInCountText" Text="0" Foreground="{StaticResource Navy}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Khách đã check-in" Foreground="{StaticResource Green}" FontSize="10"/></StackPanel></Grid></Border>
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="31" Height="31" CornerRadius="7" Background="{StaticResource AmberTint}"><TextBlock Text="◷" Foreground="{StaticResource Amber}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Chờ xác nhận" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="PendingCountText" Text="0" Foreground="{StaticResource Navy}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Booking Pending" Foreground="{StaticResource Amber}" FontSize="10"/></StackPanel></Grid></Border>
            </UniformGrid>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel>
                    <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Danh sách booking" Foreground="{StaticResource Navy}" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="BookingSummaryText" Text="" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="BookingSearchBox" Width="245" Height="34" Padding="8,6" BorderBrush="{StaticResource Line}" BorderThickness="1" ToolTip="Tìm theo mã booking, tên khách hoặc số điện thoại" TextChanged="BookingSearch_TextChanged"/><ComboBox x:Name="BookingStatusFilter" Width="165" Height="34" Margin="8,0,0,0" DisplayMemberPath="Label" SelectionChanged="BookingStatusFilter_SelectionChanged"/></StackPanel></Grid>
                    <DataGrid x:Name="ReservationsGrid" Height="360" IsReadOnly="True" CanUserResizeRows="False" SelectionMode="Single" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding BookingId}" Width="0"/>
                            <DataGridTextColumn Header="Mã booking" Binding="{Binding Code}" Width="145"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding Guest}" Width="155"/>
                            <DataGridTextColumn Header="Số điện thoại" Binding="{Binding Phone}" Width="115"/>
                            <DataGridTextColumn Header="Phòng" Binding="{Binding Room}" Width="135"/>
                            <DataGridTextColumn Header="Nhận phòng" Binding="{Binding CheckIn}" Width="100"/>
                            <DataGridTextColumn Header="Trả phòng" Binding="{Binding CheckOut}" Width="100"/>
                            <DataGridTextColumn Header="Số khách" Binding="{Binding Guests}" Width="68"/>
                            <DataGridTextColumn Header="Tiền phòng" Binding="{Binding RoomTotalLabel}" Width="115"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Style="{StaticResource OutlineButton}" Content="Chi tiết" Margin="0,0,8,0" Click="Details_Click"/><Button Style="{StaticResource OutlineButton}" Foreground="#A33A3A" Content="Hủy booking" Margin="0,0,8,0" Click="CancelBooking_Click"/><Button Style="{StaticResource OutlineButton}" Content="Check-in" Margin="0,0,8,0" Click="CheckIn_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Check-out và lập hóa đơn" Click="CheckOut_Click"/></StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
