<Window x:Class="HotelManagement.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập | Khách sạn tình yêu" Width="980" Height="620" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="#F3F6F8" FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width=".95*"/></Grid.ColumnDefinitions>
        <Border Background="#17324D" CornerRadius="16,0,0,16" Padding="42">
            <Grid><StackPanel VerticalAlignment="Center">
                <Border Width="54" Height="54" Background="#FFFFFF" CornerRadius="13" HorizontalAlignment="Left"><TextBlock Text="TY" Foreground="#17324D" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="KHÁCH SẠN TÌNH YÊU" Foreground="#9FC5E2" FontSize="11" FontWeight="Bold" Margin="0,28,0,10"/>
                <TextBlock Text="Chào mừng bạn\nquay trở lại" Foreground="White" FontSize="32" FontWeight="Bold" LineHeight="41"/>
                <TextBlock Text="Đăng nhập để tiếp tục sử dụng hệ thống quản lý lưu trú và dịch vụ khách sạn." Foreground="#D2DEE8" FontSize="14" TextWrapping="Wrap" Margin="0,18,12,0" LineHeight="23"/>
                <Border Background="#25435D" CornerRadius="8" Padding="14" Margin="0,32,0,0"><StackPanel><TextBlock Text="TÀI KHOẢN DÙNG THỬ" Foreground="#9FC5E2" FontSize="10" FontWeight="Bold"/><TextBlock Text="Mật khẩu cho cả 3 tài khoản: 123456" Foreground="White" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
            </StackPanel><TextBlock Text=".NET 8 · WPF" Foreground="#9FB1C1" FontSize="10" VerticalAlignment="Bottom"/></Grid>
        </Border>
        <Border Grid.Column="1" Background="White" CornerRadius="0,16,16,0" Padding="42">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Đăng nhập" Foreground="#17324D" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Chọn tài khoản theo vai trò để vào đúng khu vực làm việc." Foreground="#6C7C89" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,24"/>
                <TextBlock Text="Vai trò tài khoản" Foreground="#536575" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <ComboBox x:Name="RoleCombo" Height="40" Padding="9,7" SelectedIndex="0" SelectionChanged="RoleCombo_SelectionChanged">
                    <ComboBoxItem Content="Khách hàng"/><ComboBoxItem Content="Lễ tân"/><ComboBoxItem Content="Quản trị viên"/>
                </ComboBox>
                <TextBlock Text="Email" Foreground="#536575" FontWeight="SemiBold" FontSize="12" Margin="0,17,0,6"/>
                <TextBox x:Name="EmailBox" Height="40" Padding="10,8" BorderBrush="#CBD6DF" BorderThickness="1" FontSize="13"/>
                <TextBlock Text="Mật khẩu" Foreground="#536575" FontWeight="SemiBold" FontSize="12" Margin="0,17,0,6"/>
                <PasswordBox x:Name="PasswordInput" Height="40" Padding="10,8" BorderBrush="#CBD6DF" BorderThickness="1" FontSize="13"/>
                <TextBlock x:Name="ErrorText" Foreground="#B54747" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="16"/>
                <Button Content="Đăng nhập" Height="44" Background="#28699B" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Margin="0,15,0,0" Click="Login_Click"/>
                <TextBlock Text="Tài khoản demo chỉ phục vụ trình diễn giao diện môn học." Foreground="#87939D" FontSize="10" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
